PORT=3001
CORS_ORIGIN=http://localhost:5173

# Citus Database connection
CITUS_POSTGRES_USER=postgres
CITUS_POSTGRES_PASSWORD=postgres
CITUS_POSTGRES_DB=bigintensive
CITUS_HOST=citus-coordinator
CITUS_PORT=5432

# Optional: absolute path to Python executable when python/py is not in PATH
# Example: C:/Users/<you>/AppData/Local/Programs/Python/Python311/python.exe
PYTHON_BIN=

# Kafka settings for backend publishing (simulation micro-batches)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CLIENT_ID=bigintensive-backend
SMARTWATCH_KAFKA_TOPIC=heart-rate-events
